{
  "name": "command-warfare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:all": "concurrently -k -n api,web,play-api,play-http,play-https -c yellow,cyan,magenta,green,blue \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:play:server\" \"npm:dev:play:client:http\" \"npm:dev:play:client:https\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "dev:play": "concurrently -k -n cards,play-api,http,https -c magenta,yellow,cyan,blue \"npm:dev:api\" \"npm:dev:play:server\" \"npm:dev:play:client:http\" \"npm:dev:play:client:https\"",
    "dev:play:http": "concurrently -k -n cards,play-api,http -c magenta,yellow,cyan \"npm:dev:api\" \"npm:dev:play:server\" \"npm:dev:play:client:http\"",
    "dev:play:server": "tsx watch play/server/index.ts",
    "dev:play:client:http": "vite --config play/client/vite.config.ts",
    "dev:play:client:https": "vite --config play/client/vite.config.ts --mode https",
    "cert:dev": "node scripts/generate-dev-cert.mjs",
    "import:yaml": "tsx server/importYaml.ts",
    "export:unity:armies": "tsx unity/CommandWarfare/scripts/exportQuickPickArmiesUnity.ts",
    "export:unity:abilities": "node unity/CommandWarfare/scripts/exportAbilitiesJson.mjs",
    "export:unity:cards": "node unity/CommandWarfare/scripts/exportCardsJson.mjs",
    "export:unity:keywords": "node unity/CommandWarfare/scripts/exportKeywordsJson.mjs",
    "export:unity:terrain-pieces": "tsx unity/CommandWarfare/scripts/exportTerrainPiecesUnity.ts",
    "export:unity:rulebook": "node unity/CommandWarfare/scripts/exportRulebookJson.mjs",
    "export:unity:card-art": "node unity/CommandWarfare/scripts/exportCardArt.mjs",
    "export:unity:card-art": "node unity/CommandWarfare/scripts/syncCardArtToUnity.mjs",
    "check:unity:abilities": "node unity/CommandWarfare/scripts/abilityParityCheck.mjs",
    "smoke:unity:network": "tsx unity/CommandWarfare/scripts/networkSetupSmoke.ts",
    "sim:report": "node scripts/simReport.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/three": "^0.185.3",
    "better-sqlite3": "^13.0.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "image-size": "^2.0.2",
    "js-yaml": "^5.2.2",
    "multer": "^2.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "three": "^0.185.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/image-size": "^0.7.0",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "exceljs": "^4.4.0",
    "oxlint": "^1.71.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
